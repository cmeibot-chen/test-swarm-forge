{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "mutate": [
    "lib/**/*.ts",
    "!lib/db.ts"
  ],
  "disableTypeChecks": true,
  "disableBail": true,
  "concurrency": 4,
  "incremental": true,
  "incrementalFile": "build/quality/stryker-incremental.json",
  "tempDirName": "build/quality/stryker-tmp",
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "build/quality/stryker.json"
  },
  "htmlReporter": {
    "fileName": "build/quality/stryker.html"
  },
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  }
}
