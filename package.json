{
  "name": "swarmforge-typescript-next-postgres-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@9.2.0",
  "engines": { "node": ">=22.22.1 <25.0.0", "npm": ">=9.2.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "test:property": "vitest run --config vitest.property.config.ts --maxWorkers=4",
    "test:coverage": "vitest run --config vitest.config.ts --coverage --coverage.provider=istanbul --coverage.reporter=json --coverage.reportsDirectory=coverage --maxWorkers=4",
    "test:acceptance": "tsx acceptance/pipeline.ts",
    "test:acceptance:mutation": "tsx acceptance/mutation.ts",
    "test:mutation": "npm run test:acceptance:mutation",
    "test:mutation:source": "node scripts/quality.mjs mutation",
    "quality:crap": "node scripts/quality.mjs crap",
    "quality:dry": "node scripts/quality.mjs dry",
    "verify:quality": "npm run typecheck && npm run lint && npm run quality:crap && npm run quality:dry",
    "verify:hardening": "npm run typecheck && npm run lint && npm test && npm run test:property && npm run quality:crap && npm run quality:dry && npm run test:mutation:source && npm run test:acceptance && npm run test:acceptance:mutation",
    "verify:pipeline": "npm run typecheck && npm run lint && npm test && npm run test:property && npm run quality:crap && npm run quality:dry && npm run test:mutation:source && npm run test:acceptance && npm run test:acceptance:mutation && npm run test:e2e && npm run verify:container",
    "test:e2e": "playwright test",
    "test:e2e:headed": "PLAYWRIGHT_HEADED=1 playwright test",
    "migrate": "node scripts/migrate.mjs",
    "verify:container": "node scripts/verify-container.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@barney-media/crap-typescript": "0.5.2",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-istanbul": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "fast-check": "4.9.0",
    "jscpd": "5.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
